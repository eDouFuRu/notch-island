          }
        }
      }
    },
    "CFBundleName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛"
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛 controls your selected media app to play, pause, and skip tracks. Only when you click Toggle Dark Mode, it uses System Events to change the system appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛控制你选择的媒体应用以播放、暂停和切歌；仅在你点击切换深色模式时，通过 System Events 更改系统外观。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛 reads Bluetooth power status when you use its Bluetooth tool, and turns Bluetooth on or off only when you choose to toggle it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用蓝牙工具时，工位充电岛需要读取蓝牙开关状态，并在你点击切换时开启或关闭蓝牙。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛 reads calendars you enable to show your upcoming events."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛读取你启用的日历，以展示即将开始的日程。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛 reads calendars you enable to show your upcoming events."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛读取你启用的日历，以展示即将开始的日程。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛 uses the camera only when you open the mirror, to show a live preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛仅在你打开镜子时使用摄像头，以显示实时预览。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛 reads the reminder lists you enable and lets you mark reminders as complete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛读取你启用的提醒列表，并允许你标记提醒事项是否完成。"
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛 reads the reminder lists you enable and lets you mark reminders as complete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工位充电岛读取你启用的提醒列表，并允许你标记提醒事项是否完成。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
