    },
    "Use the system Stop button or press Command-Control-Escape to finish recording. Before recording starts, Escape cancels. Quitting anyway may interrupt the recording and lose its video.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the system Stop button or press Command-Control-Escape to finish recording. Before recording starts, Escape cancels. Quitting anyway may interrupt the recording and lose its video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用菜单栏的系统停止按钮，或按 Command-Control-Esc 结束录屏。尚未开始录制时可按 Esc 取消。仍然退出可能中断录屏并丢失视频。"
          }
        }
      }
    },
    "Use the system Stop button or press Command-Control-Escape to finish recording. Before recording starts, Escape cancels. The island returns when the system session ends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the system Stop button or press Command-Control-Escape to finish recording. Before recording starts, Escape cancels. The island returns when the system session ends."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用菜单栏的系统停止按钮，或按 Command-Control-Esc 结束录屏。尚未开始录制时可按 Esc 取消。系统录屏结束后，小岛会恢复显示。"
          }
        }
      }
    },
    "Use the system capture controls. Press Escape to cancel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the system capture controls. Press Escape to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用系统截屏工具；按 Esc 取消。"
          }
        }
      }
    },
    "Use the system toolbar to start recording, then its Stop button to finish. Recording has not been confirmed by the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the system toolbar to start recording, then its Stop button to finish. Recording has not been confirmed by the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用系统工具栏开始录制，再通过系统停止按钮结束。应用尚未确认录制状态。"
          }
        }
      }
    },
