    "Click the island reminder to open its original notification action when available, otherwise open hi. Continuous messages are grouped and the latest message is used.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the island reminder to open its original notification action when available, otherwise open hi. Continuous messages are grouped and the latest message is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击提醒优先执行原通知的打开动作，失效时打开 hi。连续消息合并显示，点击时使用最近一条消息。"
          }
        }
      }
    },
    "Click the island reminder to use the original notification action when available, otherwise open its source app. Bursts from the same app show the latest notification and a count.": {
