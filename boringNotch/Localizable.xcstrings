    "Ran 20 open/close cycles and 10 mid-animation reversals.\nCaptured %lld geometry and mouse-routing samples.\n%@\nSamples: %@\nReview the samples and real hovering separately; this check does not synthesize mouse input.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ran 20 open/close cycles and 10 mid-animation reversals.\nCaptured %lld geometry and mouse-routing samples.\n%@\nSamples: %@\nReview the samples and real hovering separately; this check does not synthesize mouse input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已运行 20 次展开收起和 10 次动画中途反向。\n采集 %lld 帧几何与鼠标路由记录。\n%@\n逐帧记录：%@\n请结合记录和真人悬停单独评估手感；本检查没有合成鼠标输入。"
          }
        }
      }
    },
