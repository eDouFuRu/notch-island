    },
    "One-time alarm. macOS notifications require permission and follow Focus settings; a sleeping Mac may deliver after waking.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time alarm. macOS notifications require permission and follow Focus settings; a sleeping Mac may deliver after waking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次闹钟需要系统通知权限，并遵循专注模式设置；Mac 睡眠时可能延后至唤醒后提醒。"
          }
        }
      }
    },
    "Online synced lyrics are matched by track and playback position. They may differ from your music app. Pausing hides the notch lyric row.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer original synced lyrics matching the track, album and duration. English and other languages stay original; Chinese uses simplified characters. Pausing hides the lyric row."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先匹配歌曲、专辑和时长对应的原文同步歌词。英文等语言保持原文，中文使用简体；暂停时收起歌词。"
          }
        }
      }
    },
    "Only desktop banners actually posted by each app can be mirrored. Focus, disabled banners, and app-specific notification settings may prevent delivery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only desktop banners actually posted by each app can be mirrored. Focus, disabled banners, and app-specific notification settings may prevent delivery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只转显各应用实际发出的桌面横幅。专注模式、关闭桌面横幅或应用自身的通知设置可能阻止通知送达。"
          }
        }
      }
    },
    "Only drag event counts are kept in memory; no tool names, pointer positions or clipboard contents are recorded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only drag event counts are kept in memory; no tool names, pointer positions or clipboard contents are recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在内存保留拖动事件次数，不记录工具名称、指针位置或剪贴板内容。"
          }
        }
      }
    },
    "Only indicate a new hi message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only indicate a new hi message"
