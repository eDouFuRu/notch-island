            "value": "仅提示有新通知"
          }
        }
      }
    },
    "Only new desktop banners actually shown by hi can be mirrored. Messages suppressed by Focus, desktop notification settings, or hi itself are not captured.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only new desktop banners actually shown by hi can be mirrored. Messages suppressed by Focus, desktop notification settings, or hi itself are not captured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅转显 hi 实际弹出的新桌面横幅。勿扰模式、桌面通知设置或 hi 自身未发出的横幅无法捕获。"
          }
        }
      }
    },
    "Only new screenshots in the system screenshot folder are copied. Original files are kept; old files and private app folders are not scanned.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only new screenshots in the system screenshot folder are copied. Original files are kept; old files and private app folders are not scanned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只复制系统截图目录中新产生的截图，保留原文件；不扫描旧文件或其他应用的私有目录。"
          }
        }
      }
    },
    "Only new system screenshots in the configured screenshot folder are copied. Original files stay where they are.": {
